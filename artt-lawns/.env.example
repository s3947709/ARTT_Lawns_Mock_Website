# Copy to .env.local and set a private, random access key (at least 32 characters).
# Never use NEXT_PUBLIC_ for this key.
ADMIN_QUOTE_TOKEN=
# Optional database file path on a persistent disk. Defaults to ./data/leads.sqlite.
LEADS_DATABASE_PATH=
# Legacy JSON import directory only. Defaults to ./data/quotes.
QUOTE_STORAGE_DIR=
